# Public site
ENQUIRY_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Admin authentication (server-side only — never prefix with NEXT_PUBLIC_)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional local-only fallback if you have not generated a hash yet
ADMIN_PASSWORD=
AUTH_SECRET=
ADMIN_SESSION_SECRET=

# GitHub commit API (server-side only — never prefix with NEXT_PUBLIC_)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH_DEV=dev
GITHUB_BRANCH_MAIN=main
# Optional fallback if GITHUB_BRANCH_MAIN is unset
GITHUB_BRANCH=main

# Wynderz finance & operations portal (/portal) — server-side only
# Local: postgres://USER@localhost:5432/wynderz_portal  ·  Production: hosted Postgres URL with ?sslmode=require
DATABASE_URL=
# Optional: separate database for `npm run test:db`
TEST_DATABASE_URL=
# Private document storage: "local" (default, disk) or "s3" (private S3-compatible bucket: AWS S3 / Cloudflare R2).
# Use "s3" on Vercel/serverless — the local filesystem there is ephemeral.
PORTAL_STORAGE_DRIVER=local
# local driver: directory outside /public. Must be persistent storage.
PORTAL_STORAGE_DIR=./.portal-storage
# s3 driver: bucket must be private (block all public access). Server-side only, never NEXT_PUBLIC_.
PORTAL_S3_BUCKET=
# AWS: the bucket's region (e.g. ap-south-1). R2: leave empty (defaults to "auto" when an endpoint is set).
PORTAL_S3_REGION=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  ·  AWS: leave empty
PORTAL_S3_ENDPOINT=
# Credentials scoped to this bucket (Get/Put/DeleteObject). Leave both empty to use the default AWS credential chain.
PORTAL_S3_ACCESS_KEY_ID=
PORTAL_S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, e.g. portal
PORTAL_S3_PREFIX=
# true only for MinIO-style path-addressed endpoints
PORTAL_S3_FORCE_PATH_STYLE=false
# Max upload size in MB (default 15)
PORTAL_MAX_UPLOAD_MB=15
# Postgres pool size per server instance (default 10)
PORTAL_DB_POOL_MAX=10
